' インフラ構成の記入例。ログインと商品APIを動かす想定。
' 変換はローカルの plantuml.jar と Graphviz。図の中身は外部へ送らない。
' アイコンは jar 同梱の awslib（AWS Icons for PlantUML）を使う。
' 箱と付箋の決まりは docs/guide.md の「構成図（PlantUML）の書き方」にある。
@startuml
!include <awslib/AWSCommon>
!include <awslib/Groups/AWSCloud>
!include <awslib/Groups/VPC>
!include <awslib/Groups/AvailabilityZone>
!include <awslib/Groups/PublicSubnet>
!include <awslib/Groups/PrivateSubnet>
!include <awslib/Groups/Generic>
!include <awslib/General/Users>
!include <awslib/NetworkingContentDelivery/Route53>
!include <awslib/NetworkingContentDelivery/CloudFront>
!include <awslib/Storage/SimpleStorageService>
!include <awslib/NetworkingContentDelivery/ElasticLoadBalancingApplicationLoadBalancer>
!include <awslib/NetworkingContentDelivery/VPCNATGateway>
!include <awslib/Containers/ElasticContainerService>
!include <awslib/Containers/ElasticContainerRegistry>
!include <awslib/Database/RDS>
!include <awslib/Database/ElastiCache>
!include <awslib/ManagementGovernance/CloudWatchLogs>
!include <awslib/ManagementGovernance/CloudWatchAlarm>
!include <awslib/SecurityIdentityCompliance/CertificateManager>
!include <awslib/SecurityIdentityCompliance/WAF>
!include <awslib/SecurityIdentityCompliance/SecretsManager>
!include <awslib/BusinessApplications/SimpleEmailService>
!include <awslib/ApplicationIntegration/SimpleNotificationService>

skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK JP"
skinparam ActivityFontName "Noto Sans CJK JP"

hide stereotype

title AWSインフラ構成（ログインと商品APIの記入例。決済・パスキー・アカウントの復旧は未掲載）

together {
  rectangle "イメージを push し、\nECSを更新する" as n_gha #FFFFCC
  rectangle "GitHub Actions\nECRへデプロイ" as gha
}
Users(user, "利用者\nブラウザから操作する", "ブラウザ")

AWSCloudGroup(aws, "AWS クラウド") {
  Route53(dns, "Route 53\n名前を解決する", "DNS")
  WAF(waf, "AWS WAF\n不正な要求を落とす", "Web ACL")

  SimpleStorageService(s3, "静的画面\n画面ファイルを置く", "S3")
  CloudFront(cf, "CloudFront\nHTTPSで配信する", "CDN")
  CertificateManager(acm, "ACM\nHTTPSの証明書を発行する", "HTTPS")

  together {
    rectangle "NAT経由で取得する" as n_ecr #FFFFCC
    ElasticContainerRegistry(ecr, "ECR\nAPIのイメージを置く", "レジストリ")
  }
  CloudWatchLogs(logs, "CloudWatch Logs\n両APIのログを集める", "ログ")
  CloudWatchAlarm(alarm, "CloudWatch Alarm\n障害を知らせる", "アラーム")
  together {
    rectangle "例: 5xxが増えたら、\n開発者へメールやSlack" as n_sns #FFFFCC
    SimpleNotificationService(sns, "Amazon SNS\nアラームの通知先", "通知")
  }
  SimpleEmailService(ses, "SES\nログイン通知メールを送る", "メール")
  SecretsManager(sm, "Secrets Manager\nDBパスワードを置く", "機密")

  VPCGroup(vpc, "VPC") {
    ElasticLoadBalancingApplicationLoadBalancer(alb, "ALB\n2つのAZのAPIへ振り分ける", "1a・1cのパブリックサブネット")

    AvailabilityZoneGroup(az1, "AZ ap-northeast-1a") {
      PublicSubnetGroup(pub1, "パブリックサブネット") {
        VPCNATGateway(nat1, "NAT Gateway\nこのAZのAPIの出口", "1a")
      }
      PrivateSubnetGroup(pri1, "プライベートサブネット") {
        ElasticContainerService(ecs1, "APIサービス\nログインと商品のAPI", "ECS Fargate")
      }
    }
    AvailabilityZoneGroup(az2, "AZ ap-northeast-1c") {
      PublicSubnetGroup(pub2, "パブリックサブネット") {
        VPCNATGateway(nat2, "NAT Gateway\nこのAZのAPIの出口", "1c")
      }
      PrivateSubnetGroup(pri2, "プライベートサブネット") {
        ElasticContainerService(ecs2, "APIサービス\nログインと商品のAPI", "ECS Fargate")
      }
    }

    rectangle "両APIからの通信（合流）" as j

    GenericGroup(data, "データ（マルチAZ）") {
      together {
        rectangle "どのAPIでも\nログインが続く" as n_cache #FFFFCC
        ElastiCache(cachep, "ElastiCache プライマリ（1a）\nセッションと失敗回数・ロックを置く", "Redis")
      }
      RDS(rdsp, "RDS プライマリ（1a）\n商品・利用者を置く", "DB")
      ElastiCache(cacher, "ElastiCache レプリカ（1c）\n障害時の読み取り先", "Redis")
      RDS(rdss, "RDS スタンバイ（1c）\n障害時に昇格する", "マルチAZ")
    }
  }
}

' ---- 通信の流れ ----
user -down-> dns
dns -down-> cf
dns -[hidden]right- waf
waf -down..> cf
cf -left-> s3
acm -left..> cf : 証明書
acm -down..> alb : 証明書
cf -down-> alb
nat1 -[hidden]right- ecs1
ecs2 -[hidden]right- nat2
alb -[hidden]down- az1
alb -[hidden]down- az2
az1 -[hidden]right- az2
nat1 -[hidden]right- nat2
alb -down-> ecs1
alb -down-> ecs2
ecs1 -down-> j
ecs2 -down-> j
j -down-> cachep
j -down-> rdsp
cachep -down-> cacher
rdsp -down-> rdss
n_cache -[dotted]right- cachep
cachep -[hidden]right- rdsp
cacher -[hidden]right- rdss
j -right-> ses : NAT経由
j -right-> sm : NAT経由
ses -[hidden]down- sm
az1 -[hidden]right- az2

' ---- 左列（AWSクラウド内・VPC外）とデプロイ ----
gha -[hidden]right- user
n_gha -[dotted]right- gha
gha -down-> ecr
n_ecr -[dotted]right- ecr
n_sns -[dotted]right- sns
ecr -[hidden]down- logs
logs -down-> alarm
alarm -down-> sns
ecr -[hidden]right- vpc
ecr -[hidden]right- alb
logs -[hidden]right- az1
alarm -[hidden]right- az1
sns -[hidden]right- data
ses -[hidden]right- j
sm -[hidden]right- data

@enduml
