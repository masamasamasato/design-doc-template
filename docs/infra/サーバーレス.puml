' インフラ構成の記入例。サーバーレス（API GatewayとLambda、DynamoDB）。
' 変換はローカルの plantuml.jar と Graphviz。図の中身は外部へ送らない。
' アイコンは jar 同梱の awslib（AWS Icons for PlantUML）を使う。
' 箱と付箋の決まりは docs/guide.md の「構成図（PlantUML）の書き方」にある。
@startuml
!include <awslib/AWSCommon>
!include <awslib/Groups/AWSCloud>
!include <awslib/General/Users>
!include <awslib/NetworkingContentDelivery/Route53>
!include <awslib/ApplicationIntegration/APIGateway>
!include <awslib/Compute/Lambda>
!include <awslib/Database/DynamoDB>
!include <awslib/ManagementGovernance/CloudWatchLogs>

skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK JP"
hide stereotype

title サーバーレス（API GatewayとLambda、DynamoDB）

Users(user, "利用者\nブラウザから操作する", "ブラウザ")

AWSCloudGroup(aws, "AWS クラウド") {
  Route53(dns, "Route 53\n名前を解決する", "DNS")
  APIGateway(apigw, "API Gateway\nHTTPSでAPIを受け付ける", "HTTP API")
  together {
    rectangle "アクセスに合わせて増減する" as n_fn #FFFFCC
    Lambda(fn, "Lambda\nログインと商品のAPIを動かす", "関数")
  }
  together {
    rectangle "キーで利用者と商品を引く" as n_ddb #FFFFCC
    DynamoDB(ddb, "DynamoDB\n利用者と商品を置く", "テーブル")
  }
  CloudWatchLogs(logs, "CloudWatch Logs\nAPIのログを集める", "ログ")
}

user -down-> dns
dns -down-> apigw
apigw -down-> fn
fn -down-> ddb
n_fn -[dotted]right- fn
n_ddb -[dotted]right- ddb
fn -[hidden]right- logs
fn -right-> logs

@enduml
