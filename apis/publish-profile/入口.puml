@startuml
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK JP"
skinparam SequenceFontName "Noto Sans CJK JP"
hide footbox

title プロフィールを公開する

actor "利用者" as User
participant "プロフィール画面" as Screen
participant "プロフィールAPI" as API

User -> Screen : 公開する
Screen -> API : POST /profiles/{id}/publish
API -> API : checkOwner()
alt 本人確認が済んでいる
  API -> API : publish()
  API --> Screen : 200 公開中
  Screen --> User : 公開できた
else 本人確認が済んでいない
  API --> Screen : 403 NOT_VERIFIED
  Screen --> User : 先に本人確認が必要
end
@enduml
