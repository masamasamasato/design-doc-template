@startuml
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK JP"
skinparam SequenceFontName "Noto Sans CJK JP"
hide footbox

title プロフィールを公開する

actor "利用者" as User
participant "プロフィール画面" as Screen
participant "プロフィールAPI" as API

User -> Screen : 公開する
Screen -> API : POST /profiles/{id}/publish\nセッションの Cookie を付ける
API -> API : requireSession()
alt ログインしていない
  API --> Screen : 401 UNAUTHORIZED
  Screen --> User : ログインが必要
else ログインしている
  API -> API : 持ち主か、本人確認済みかを確かめる\ncheckOwner()
  alt プロフィールが無い
    API --> Screen : 404 NOT_FOUND
    Screen --> User : プロフィールが無い
  else 呼んだ人が持ち主でない
    API --> Screen : 403 FORBIDDEN
    Screen --> User : 公開できない
  else 持ち主だが、本人確認が済んでいない
    API --> Screen : 403 NOT_VERIFIED
    Screen --> User : 先に本人確認が必要
  else 持ち主で、本人確認済み
    API -> API : publish()
    API --> Screen : 200 公開中
    Screen --> User : 公開できた
  end
end
@enduml
