@startuml
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK JP"
skinparam SequenceFontName "Noto Sans CJK JP"
hide footbox

title 商品を検索する

actor "ユーザー" as User
participant "商品画面" as Screen
participant "商品API" as API

User -> Screen : 検索する
Screen -> API : GET /products/search?q=デスク&page=1&limit=20
API -> API : requireSession()
alt ログインしていて、条件とページ分けが正しい
  API -> API : searchProducts()
  API --> Screen : 200 一覧
  Screen --> User : 結果が見えた
else ログインしていない
  API --> Screen : 401 UNAUTHORIZED
  Screen --> User : ログインが必要
else 条件、ページ分け、または並び順が正しくない
  API --> Screen : 400 INVALID_QUERY
  Screen --> User : 指定を直す
end
@enduml
