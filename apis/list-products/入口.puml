@startuml
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK JP"
skinparam SequenceFontName "Noto Sans CJK JP"
hide footbox

title 商品一覧を取得する

actor "利用者" as User
participant "商品画面" as Screen
participant "商品API" as API

User -> Screen : 一覧を見る
Screen -> API : GET /products?page=1&limit=20
API -> API : requireSession()
alt ログインしていて、ページ分けが正しい
  API -> API : listProducts()
  API --> Screen : 200 一覧
  Screen --> User : 一覧が見えた
else ログインしていない
  API --> Screen : 401 UNAUTHORIZED
  Screen --> User : ログインが必要
else ページ分けまたは並び順が正しくない
  API --> Screen : 400 INVALID_QUERY
  Screen --> User : 指定を直す
end
@enduml
